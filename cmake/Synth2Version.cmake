# Release tags are the only maintained version source. Local/archive builds use
# a dated development label; plugins and bundle formats still need numeric words.
function(synth2_configure_version source_dir output_dir)
    set(tag "${SYNTH2_RELEASE_TAG}")
    if(tag STREQUAL "" AND "$ENV{GITHUB_ACTIONS}" STREQUAL "true"
       AND "$ENV{GITHUB_REF_TYPE}" STREQUAL "tag")
        set(tag "$ENV{GITHUB_REF_NAME}")
    endif()
    if(NOT tag STREQUAL "")
        if(NOT tag MATCHES "^v([0-9]+)\\.([0-9]+)\\.([0-9]+)(-[0-9A-Za-z.-]+)?$")
            message(FATAL_ERROR "Release version must be a vMAJOR.MINOR.PATCH tag, optionally with a prerelease suffix")
        endif()
        set(major "${CMAKE_MATCH_1}")
        set(minor "${CMAKE_MATCH_2}")
        set(patch "${CMAKE_MATCH_3}")
        foreach(part major minor patch)
            if("${${part}}" MATCHES "^0[0-9]" OR "${${part}}" GREATER 65535)
                message(FATAL_ERROR "Release version components must be canonical integers in the plugin version range")
            endif()
        endforeach()
        if(minor GREATER 255 OR patch GREATER 255)
            message(FATAL_ERROR "Plugin minor and patch versions must fit in 8 bits")
        endif()
        string(SUBSTRING "${tag}" 1 -1 SYNTH2_BUILD_VERSION)
    else()
        set(major 0)
        set(minor 0)
        set(patch 0)
        # CMake honors SOURCE_DATE_EPOCH for reproducible development snapshots.
        string(TIMESTAMP day "%Y%m%d" UTC)
        set(SYNTH2_BUILD_VERSION "0.0.0-dev.${day}")
        if(EXISTS "${source_dir}/.git")
            find_package(Git QUIET)
            if(Git_FOUND)
                execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source_dir}" rev-parse --short=12 HEAD
                    OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE
                    RESULT_VARIABLE git_result ERROR_QUIET)
                if(git_result EQUAL 0)
                    string(APPEND SYNTH2_BUILD_VERSION ".g${revision}")
                endif()
            endif()
        endif()
    endif()
    set(SYNTH2_NUMERIC_VERSION "${major}.${minor}.${patch}")
    set(SYNTH2_FILE_VERSION "${major},${minor},${patch},0")
    math(EXPR SYNTH2_VERSION_NUMBER "(${major} << 16) | (${minor} << 8) | ${patch}")
    math(EXPR SYNTH2_VERSION_HEX "${SYNTH2_VERSION_NUMBER}" OUTPUT_FORMAT HEXADECIMAL)
    file(MAKE_DIRECTORY "${output_dir}")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/BuildVersion.h.in"
        "${output_dir}/BuildVersion.h" @ONLY)
    foreach(format AU CLAP VST3 macOS)
        configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../projects/Synth2/resources/Synth2-${format}-Info.plist.in"
            "${output_dir}/Synth2-${format}-Info.plist" @ONLY)
    endforeach()
    foreach(value SYNTH2_BUILD_VERSION SYNTH2_NUMERIC_VERSION SYNTH2_FILE_VERSION
                  SYNTH2_VERSION_NUMBER SYNTH2_VERSION_HEX)
        set(${value} "${${value}}" PARENT_SCOPE)
    endforeach()
    set(SYNTH2_VERSION_DIR "${output_dir}" PARENT_SCOPE)
    message(STATUS "Synth2 build version: ${SYNTH2_BUILD_VERSION}")
endfunction()
