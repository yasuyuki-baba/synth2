if(NOT SYNTH2_BUILD_IPLUG2)
    message(FATAL_ERROR "Native audio smoke tests require SYNTH2_BUILD_IPLUG2=ON")
endif()
add_executable(Synth2AudioSmoke tests/native/AudioSmoke.cpp)
target_compile_features(Synth2AudioSmoke PRIVATE cxx_std_20)
target_compile_definitions(Synth2AudioSmoke PRIVATE $<$<CONFIG:Debug>:DEVELOPMENT=1> $<$<NOT:$<CONFIG:Debug>>:RELEASE=1>)
target_include_directories(Synth2AudioSmoke PRIVATE
    "${IPLUG2_DIR}/Dependencies/IPlug/VST3_SDK"
    "${IPLUG2_DIR}/Dependencies/IPlug/CLAP_SDK/include")
target_link_libraries(Synth2AudioSmoke PRIVATE Synth2Core ${CMAKE_DL_LIBS})
if(APPLE)
    target_link_libraries(Synth2AudioSmoke PRIVATE "-framework AudioToolbox" "-framework CoreFoundation")
endif()
foreach(format vst3 clap au)
    if(TARGET Synth2-${format})
        if(format STREQUAL "vst3")
            target_sources(Synth2AudioSmoke PRIVATE tests/native/Vst3Host.cpp)
        elseif(format STREQUAL "clap")
            target_sources(Synth2AudioSmoke PRIVATE tests/native/ClapHost.cpp)
        else()
            target_sources(Synth2AudioSmoke PRIVATE tests/native/AuHost.cpp)
        endif()
        string(TOUPPER ${format} upper_format)
        target_compile_definitions(Synth2AudioSmoke PRIVATE SYNTH2_SMOKE_${upper_format}=1)
        set(synth2_has_smoke_format TRUE)
        add_dependencies(Synth2AudioSmoke Synth2-${format})
        add_test(NAME NativeAudioSmoke-${format} COMMAND Synth2AudioSmoke
            ${format} "$<TARGET_FILE:Synth2-${format}>" "${CMAKE_CURRENT_SOURCE_DIR}/tests/native/patches")
        set_tests_properties(NativeAudioSmoke-${format} PROPERTIES LABELS "native;smoke" TIMEOUT 60)
    endif()
endforeach()
if(NOT synth2_has_smoke_format)
    message(FATAL_ERROR "Native audio smoke tests require at least one plugin format (VST3, CLAP or AU)")
endif()
